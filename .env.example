# StockLens Configuration
# Educational use only. Not investment advice.

# Cache configuration
STOCKLENS_DB_PATH=stocklens_cache.db
STOCKLENS_CACHE_HOURS=24

# Default Provider: yfinance | moneycontrol | demo
STOCKLENS_DEFAULT_PROVIDER=yfinance

# Moneycontrol Scraper Configuration
MONEYCONTROL_USER_AGENT=StockLens/1.0 (Indian Stock Analysis Educational Project; contact: user@stocklens.local)
SCRAPER_RATE_LIMIT_SECONDS=2.5

# Optional Third-Party or Licensed Exchange APIs (Never hardcode credentials)
NSE_API_KEY=
FINANCIAL_API_KEY=
